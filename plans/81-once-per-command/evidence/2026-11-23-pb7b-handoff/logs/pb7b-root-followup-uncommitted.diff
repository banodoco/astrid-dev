diff --git a/tests/core/pack/test_discovery_admission_order.py b/tests/core/pack/test_discovery_admission_order.py
index 176daa51b..40645698a 100644
--- a/tests/core/pack/test_discovery_admission_order.py
+++ b/tests/core/pack/test_discovery_admission_order.py
@@ -1,6 +1,8 @@
 """Duplicate directory admission precedes managed inventory verification."""
 
 from contextlib import nullcontext
+from pathlib import Path
+import sys
 
 import pytest
 
@@ -65,3 +67,45 @@ def test_unresolvable_declarations_path_does_not_change_empty_discovery(tmp_path
         scoped = discovery.discover_pack_metadata(project_root=tmp_path, extra_pack_roots=(extra,))
         assert discovery.discover_pack_metadata(project_root=tmp_path, extra_pack_roots=(extra,)) == scoped
     assert scoped == unscoped == ()
+
+
+@pytest.mark.skipif(not sys.platform.startswith("linux"), reason="Linux directory witness")
+def test_scoped_root_names_reused_and_changes_readmitted(tmp_path, roots, monkeypatch):
+    source, extra, calls = roots
+    target = tmp_path / "target"
+    target.write_text("file")
+    (source / "same").symlink_to(target)
+    (extra / "same").mkdir()
+    original_iterdir = Path.iterdir
+    enumerated = []
+
+    def counted(path):
+        if path in (source, extra):
+            enumerated.append(path)
+        return original_iterdir(path)
+
+    monkeypatch.setattr(Path, "iterdir", counted)
+    with discovery.pack_discovery_scope():
+        assert discovery.discover_pack_metadata(project_root=tmp_path, extra_pack_roots=(extra,)) == ()
+        enumerated.clear()
+        assert discovery.discover_pack_metadata(project_root=tmp_path, extra_pack_roots=(extra,)) == ()
+        assert enumerated == []
+
+        # An entry can change type without changing its containing root.
+        target.unlink()
+        target.mkdir()
+        calls.clear()
+        with pytest.raises(PackValidationError, match="duplicate pack"):
+            discovery.discover_pack_metadata(project_root=tmp_path, extra_pack_roots=(extra,))
+        assert calls == []
+        assert enumerated == []
+
+        (source / "same").unlink()
+        calls.clear()
+        assert discovery.discover_pack_metadata(project_root=tmp_path, extra_pack_roots=(extra,)) == ()
+        assert source in enumerated
+        (source / "same").mkdir()
+        calls.clear()
+        with pytest.raises(PackValidationError, match="duplicate pack"):
+            discovery.discover_pack_metadata(project_root=tmp_path, extra_pack_roots=(extra,))
+        assert calls == []
