index 4fb4184c8..cadfda103 100644
--- a/astrid/_pack_discovery_scope.py
+++ b/astrid/_pack_discovery_scope.py
@@ -14,6 +14,7 @@ class _DiscoveryCache(dict):
         self.active = True
         self._lock = Lock()
         self._roots = {}
+        self._root_entries = {}
         self._generation = 0
 
     def read(self, key):
@@ -50,10 +51,32 @@ class _DiscoveryCache(dict):
                 self._roots.pop(root, None)
                 return _tree_fingerprint(root)
 
+    def root_entries(self, root):
+        """Reuse immediate names only while the Linux directory is unchanged."""
+        with self._lock:
+            if not self.active or not sys.platform.startswith("linux"):
+                return tuple(root.iterdir())
+            def witness():
+                info = root.stat()
+                return (info.st_dev, info.st_ino, info.st_mode,
+                        info.st_mtime_ns, info.st_ctime_ns)
+
+            before = witness()
+            cached = self._root_entries.get(root)
+            if cached is not None and cached[0] == before:
+                return cached[1]
+            entries = tuple(root.iterdir())
+            if before == witness():
+                self._root_entries[root] = (before, entries)
+            else:
+                self._root_entries.pop(root, None)
+            return entries
+
     def revoke(self):
         with self._lock:
             self.active = False
             self._roots.clear()
+            self._root_entries.clear()
             self.clear()
 
 
