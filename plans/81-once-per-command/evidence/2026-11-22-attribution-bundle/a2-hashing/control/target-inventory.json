                    {
                      "tooltip": "Standalone reference audio"
                    }
                  ]
                }
              },
              "max": 3,
              "min": 0,
              "prefix": "ref_audio_"
            }
          }
        ],
        "ref_images": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_image": [
                    "IMAGE",
                    {
                      "tooltip": "Reference image (downscaled to 2048 short edge if larger, never upscaled)"
                    }
                  ]
                }
              },
              "max": 9,
              "min": 0,
              "prefix": "ref_image_"
            }
          }
        ],
        "ref_video_audios": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_video_audio": [
                    "AUDIO",
                    {
                      "tooltip": "Soundtrack of the same-numbered reference video"
                    }
                  ]
                }
              },
              "max": 3,
              "min": 0,
              "prefix": "ref_video_audio_"
            }
          }
        ],
        "ref_videos": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_video": [
                    "IMAGE",
                    {
                      "tooltip": "Reference video frames at 24 fps (2-15s)"
                    }
                  ]
                }
              },
              "max": 3,
              "min": 0,
              "prefix": "ref_video_"
            }
          }
        ],
        "vae": [
          "VAE",
          {
            "tooltip": "Video VAE. Without it reference images/videos only condition the text encoder."
          }
        ]
      },
      "required": {
        "clip": [
          "CLIP",
          {}
        ],
        "height": [
          "INT",
          {
            "default": 768,
            "max": 16384,
            "min": 32,
            "step": 32
          }
        ],
        "length": [
          "INT",
          {
            "default": 124,
            "max": 3600,
            "min": 5,
            "step": 17,
            "tooltip": "Frame count at 24 fps, (124 = ~5s, trained range is ~124-362)"
          }
        ],
        "prompt": [
          "STRING",
          {
            "dynamicPrompts": true,
            "multiline": true
          }
        ],
        "ref_image_size": [
          "COMBO",
          {
            "default": "match",
            "multiselect": false,
            "options": [
              "match",
              "max"
            ],
